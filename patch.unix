import { http, createConfig } from 'wagmi';
import { base, baseSepolia } from 'wagmi/chains';
import { getDefaultConfig } from '@rainbow-me/rainbowkit';
import { injectedWallet, metaMaskWallet, coinbaseWallet } from '@rainbow-me/rainbowkit/wallets';

export const config = getDefaultConfig({
  appName: 'BaseFlow AI',
  projectId: '352cc4a8584fc3f3483adfeaa376754c',
  chains: [baseSepolia, base],
  transports: {
    [base.id]: http(),
    [baseSepolia.id]: http(),
  },
  // Customize wallet options to prioritize browser wallets over QR code wallets
  wallets: [
    {
      groupName: 'Recommended',
      wallets: [
        injectedWallet,
        metaMaskWallet,
        coinbaseWallet,
      ]
    }
  ],
  // Disable the QR code modal
  modalOptions: {
    enableExternalBrowserWallets: false,
  }
});
